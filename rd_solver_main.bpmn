        <dc:Bounds x="645" y="830" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="620" y="880" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
