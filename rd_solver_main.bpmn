      <bpmndi:BPMNShape id="Lane_fivewhys_di" bpmnElement="Lane_fivewhys" isHorizontal="true">
        <dc:Bounds x="190" y="240" width="2070" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_orchestrator_di" bpmnElement="Lane_orchestrator" isHorizontal="true">
        <dc:Bounds x="190" y="520" width="2070" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_triz_di" bpmnElement="Lane_triz" isHorizontal="true">
        <dc:Bounds x="190" y="660" width="2070" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="224" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="200" y="185" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
