        <dc:Bounds x="1665" y="455" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1650" y="435" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_ws_triz_di" bpmnElement="Annotation_ws_triz">
        <dc:Bounds x="780" y="665" width="170" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_ws_5w_di" bpmnElement="Annotation_ws_5w">
        <dc:Bounds x="870" y="430" width="180" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_ws_eval_di" bpmnElement="Annotation_ws_eval">
        <dc:Bounds x="1470" y="668" width="160" height="38" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_persist_di" bpmnElement="Annotation_persist">
        <dc:Bounds x="1490" y="390" width="200" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_split_di" bpmnElement="Flow_start_split">
        <di:waypoint x="242" y="178" />
        <di:waypoint x="242" y="590" />
        <di:waypoint x="340" y="590" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_split_ask_di" bpmnElement="Flow_split_ask">
        <di:waypoint x="365" y="565" />
        <di:waypoint x="365" y="330" />
        <di:waypoint x="430" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_split_contradiction_di" bpmnElement="Flow_split_contradiction">
        <di:waypoint x="365" y="615" />
        <di:waypoint x="365" y="780" />
        <di:waypoint x="430" y="780" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ask_answer_di" bpmnElement="Flow_ask_answer">
        <di:waypoint x="490" y="295" />
        <di:waypoint x="490" y="160" />
        <di:waypoint x="500" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_answer_ontopic_di" bpmnElement="Flow_answer_ontopic">
        <di:waypoint x="560" y="195" />
        <di:waypoint x="560" y="330" />
        <di:waypoint x="610" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ontopic_ok_di" bpmnElement="Flow_ontopic_ok">
        <di:waypoint x="660" y="330" />
        <di:waypoint x="800" y="330" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="708" y="312" width="34" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ontopic_offtopic_di" bpmnElement="Flow_ontopic_offtopic">
        <di:waypoint x="635" y="355" />
        <di:waypoint x="635" y="460" />
        <di:waypoint x="550" y="460" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="640" y="400" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ontopic_stuck_di" bpmnElement="Flow_ontopic_stuck">
        <di:waypoint x="635" y="355" />
        <di:waypoint x="635" y="405" />
        <di:waypoint x="760" y="405" />
        <di:waypoint x="760" y="430" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="666" y="388" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_restate_ask_di" bpmnElement="Flow_restate_ask">
        <di:waypoint x="490" y="430" />
