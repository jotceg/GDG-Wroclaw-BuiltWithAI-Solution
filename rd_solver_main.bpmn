<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_rd_solver_main" targetNamespace="http://example.com/rd-solver" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:collaboration id="Collaboration_rd">
    <bpmn:participant id="Participant_rd" name="R&#38;D inventive-problem solver" processRef="Process_rd" />
  </bpmn:collaboration>
  <bpmn:process id="Process_rd" isExecutable="false">
    <bpmn:laneSet id="LaneSet_rd">
      <bpmn:lane id="Lane_engineer" name="Engineer / R&#38;D user">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_confirm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_fivewhys" name="5 Whys agent (root-cause &#8594; countermeasures)">
        <bpmn:flowNodeRef>Task_ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ontopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_restate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_rootcause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_gen5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_5count</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_orchestrator" name="Orchestrator">
        <bpmn:flowNodeRef>Gateway_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_triz" name="TRIZ agent (contradiction matrix)">
        <bpmn:flowNodeRef>Task_contradiction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_matrix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_instantiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_trizcount</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Problem submitted">
      <bpmn:outgoing>Flow_start_split</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_split" name="Run both methods in parallel">
      <bpmn:incoming>Flow_start_split</bpmn:incoming>
      <bpmn:outgoing>Flow_split_ask</bpmn:outgoing>
      <bpmn:outgoing>Flow_split_contradiction</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_ask" name="Ask next &#39;Why?&#39; (scoped to problem)">
      <bpmn:incoming>Flow_split_ask</bpmn:incoming>
      <bpmn:incoming>Flow_restate_ask</bpmn:incoming>
      <bpmn:incoming>Flow_rootcause_no</bpmn:incoming>
      <bpmn:outgoing>Flow_ask_answer</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_answer" name="Engineer answers">
      <bpmn:incoming>Flow_ask_answer</bpmn:incoming>
      <bpmn:outgoing>Flow_answer_ontopic</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ontopic" name="Answer on-topic &#38; usable?">
      <bpmn:incoming>Flow_answer_ontopic</bpmn:incoming>
      <bpmn:outgoing>Flow_ontopic_ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_ontopic_offtopic</bpmn:outgoing>
      <bpmn:outgoing>Flow_ontopic_stuck</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_restate" name="Restate scope, refuse off-topic">
      <bpmn:incoming>Flow_ontopic_offtopic</bpmn:incoming>
      <bpmn:outgoing>Flow_restate_ask</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_offer" name="Offer hypotheses to verify (web search)">
      <bpmn:incoming>Flow_ontopic_stuck</bpmn:incoming>
      <bpmn:outgoing>Flow_offer_confirm</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_confirm" name="Engineer confirms / rejects">
      <bpmn:incoming>Flow_offer_confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_confirm_rootcause</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_rootcause" name="Root cause reached? (max 5 whys)">
      <bpmn:incoming>Flow_ontopic_ok</bpmn:incoming>
      <bpmn:incoming>Flow_confirm_rootcause</bpmn:incoming>
      <bpmn:outgoing>Flow_rootcause_no</bpmn:outgoing>
      <bpmn:outgoing>Flow_rootcause_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_gen5" name="Generate &#8805;3 solutions for root cause">
      <bpmn:incoming>Flow_rootcause_yes</bpmn:incoming>
      <bpmn:incoming>Flow_5_loop</bpmn:incoming>
      <bpmn:outgoing>Flow_gen_5count</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_5count" name="&#8805; 3 candidates?">
      <bpmn:incoming>Flow_gen_5count</bpmn:incoming>
      <bpmn:outgoing>Flow_5_loop</bpmn:outgoing>
      <bpmn:outgoing>Flow_5_done</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_contradiction" name="Formulate technical contradiction">
      <bpmn:incoming>Flow_split_contradiction</bpmn:incoming>
      <bpmn:outgoing>Flow_contradiction_matrix</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_matrix" name="Apply contradiction matrix &#8594; principles">
      <bpmn:incoming>Flow_contradiction_matrix</bpmn:incoming>
      <bpmn:outgoing>Flow_matrix_instantiate</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_instantiate" name="Instantiate principle into candidate">
      <bpmn:incoming>Flow_matrix_instantiate</bpmn:incoming>
      <bpmn:incoming>Flow_triz_loop</bpmn:incoming>
      <bpmn:outgoing>Flow_instantiate_count</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_trizcount" name="&#8805; 3 candidates?">
      <bpmn:incoming>Flow_instantiate_count</bpmn:incoming>
      <bpmn:outgoing>Flow_triz_loop</bpmn:outgoing>
      <bpmn:outgoing>Flow_triz_done</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_join" name="Both methods complete">
      <bpmn:incoming>Flow_triz_done</bpmn:incoming>
      <bpmn:incoming>Flow_5_done</bpmn:incoming>
      <bpmn:outgoing>Flow_join_merge</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_merge" name="Merge candidate pool (6+ candidates)">
      <bpmn:incoming>Flow_join_merge</bpmn:incoming>
      <bpmn:outgoing>Flow_merge_evaluate</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_evaluate" name="Evaluate all candidates vs problem">
      <bpmn:incoming>Flow_merge_evaluate</bpmn:incoming>
      <bpmn:outgoing>Flow_evaluate_select</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_select" name="Select best &#38; assemble reasoning trail">
      <bpmn:incoming>Flow_evaluate_select</bpmn:incoming>
      <bpmn:outgoing>Flow_select_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Present recommendation">
      <bpmn:incoming>Flow_select_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStore_matrix" name="39&#215;39 contradiction matrix (pytriz)" />
    <bpmn:dataStoreReference id="DataStore_trail" name="Reasoning trail (Postgres)" />
    <bpmn:textAnnotation id="Annotation_ws_triz">
      <bpmn:text>web search / retrieval tool</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_ws_5w">
      <bpmn:text>hypotheses grounded via web search; human confirms</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_ws_eval">
      <bpmn:text>web search / retrieval tool</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_persist">
      <bpmn:text>every step persisted &#8594; inspectable trail on UI</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Flow_start_split" sourceRef="StartEvent_1" targetRef="Gateway_split" />
    <bpmn:sequenceFlow id="Flow_split_ask" sourceRef="Gateway_split" targetRef="Task_ask" />
    <bpmn:sequenceFlow id="Flow_split_contradiction" sourceRef="Gateway_split" targetRef="Task_contradiction" />
    <bpmn:sequenceFlow id="Flow_ask_answer" sourceRef="Task_ask" targetRef="Task_answer" />
    <bpmn:sequenceFlow id="Flow_answer_ontopic" sourceRef="Task_answer" targetRef="Gateway_ontopic" />
    <bpmn:sequenceFlow id="Flow_ontopic_ok" name="usable" sourceRef="Gateway_ontopic" targetRef="Gateway_rootcause" />
    <bpmn:sequenceFlow id="Flow_ontopic_offtopic" name="off-topic / abuse" sourceRef="Gateway_ontopic" targetRef="Task_restate" />
    <bpmn:sequenceFlow id="Flow_ontopic_stuck" name="stuck (opt-in)" sourceRef="Gateway_ontopic" targetRef="Task_offer" />
    <bpmn:sequenceFlow id="Flow_restate_ask" sourceRef="Task_restate" targetRef="Task_ask" />
    <bpmn:sequenceFlow id="Flow_offer_confirm" sourceRef="Task_offer" targetRef="Task_confirm" />
    <bpmn:sequenceFlow id="Flow_confirm_rootcause" sourceRef="Task_confirm" targetRef="Gateway_rootcause" />
    <bpmn:sequenceFlow id="Flow_rootcause_no" name="not root cause" sourceRef="Gateway_rootcause" targetRef="Task_ask" />
    <bpmn:sequenceFlow id="Flow_rootcause_yes" name="root cause found" sourceRef="Gateway_rootcause" targetRef="Task_gen5" />
    <bpmn:sequenceFlow id="Flow_gen_5count" sourceRef="Task_gen5" targetRef="Gateway_5count" />
    <bpmn:sequenceFlow id="Flow_5_loop" name="&#60; 3" sourceRef="Gateway_5count" targetRef="Task_gen5" />
    <bpmn:sequenceFlow id="Flow_5_done" name="&#8805; 3" sourceRef="Gateway_5count" targetRef="Gateway_join" />
    <bpmn:sequenceFlow id="Flow_contradiction_matrix" sourceRef="Task_contradiction" targetRef="Task_matrix" />
    <bpmn:sequenceFlow id="Flow_matrix_instantiate" sourceRef="Task_matrix" targetRef="Task_instantiate" />
    <bpmn:sequenceFlow id="Flow_instantiate_count" sourceRef="Task_instantiate" targetRef="Gateway_trizcount" />
    <bpmn:sequenceFlow id="Flow_triz_loop" name="&#60; 3, next principle" sourceRef="Gateway_trizcount" targetRef="Task_instantiate" />
    <bpmn:sequenceFlow id="Flow_triz_done" name="&#8805; 3" sourceRef="Gateway_trizcount" targetRef="Gateway_join" />
    <bpmn:sequenceFlow id="Flow_join_merge" sourceRef="Gateway_join" targetRef="Task_merge" />
    <bpmn:sequenceFlow id="Flow_merge_evaluate" sourceRef="Task_merge" targetRef="Task_evaluate" />
    <bpmn:sequenceFlow id="Flow_evaluate_select" sourceRef="Task_evaluate" targetRef="Task_select" />
    <bpmn:sequenceFlow id="Flow_select_end" sourceRef="Task_select" targetRef="EndEvent_1" />
    <bpmn:association id="Assoc_matrix" sourceRef="DataStore_matrix" targetRef="Task_matrix" />
    <bpmn:association id="Assoc_trail" sourceRef="DataStore_trail" targetRef="Task_select" />
    <bpmn:association id="Assoc_ann_triz" sourceRef="Annotation_ws_triz" targetRef="Task_instantiate" />
    <bpmn:association id="Assoc_ann_5w" sourceRef="Annotation_ws_5w" targetRef="Task_offer" />
    <bpmn:association id="Assoc_ann_eval" sourceRef="Annotation_ws_eval" targetRef="Task_evaluate" />
    <bpmn:association id="Assoc_ann_persist" sourceRef="Annotation_persist" targetRef="DataStore_trail" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_rd">
      <bpmndi:BPMNShape id="Participant_rd_di" bpmnElement="Participant_rd" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2100" height="820" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_engineer_di" bpmnElement="Lane_engineer" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2070" height="160" />
