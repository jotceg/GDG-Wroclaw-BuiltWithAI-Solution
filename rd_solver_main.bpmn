        <dc:Bounds x="610" y="305" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="596" y="362" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_restate_di" bpmnElement="Task_restate">
        <dc:Bounds x="430" y="430" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_offer_di" bpmnElement="Task_offer">
        <dc:Bounds x="700" y="430" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_rootcause_di" bpmnElement="Gateway_rootcause" isMarkerVisible="true">
        <dc:Bounds x="800" y="305" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="785" y="268" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_gen5_di" bpmnElement="Task_gen5">
        <dc:Bounds x="910" y="295" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_5count_di" bpmnElement="Gateway_5count" isMarkerVisible="true">
        <dc:Bounds x="1090" y="305" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1083" y="278" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_split_di" bpmnElement="Gateway_split">
        <dc:Bounds x="340" y="565" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="325" y="616" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_join_di" bpmnElement="Gateway_join">
        <dc:Bounds x="1220" y="565" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1206" y="616" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_merge_di" bpmnElement="Task_merge">
        <dc:Bounds x="1310" y="555" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_evaluate_di" bpmnElement="Task_evaluate">
        <dc:Bounds x="1470" y="555" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_select_di" bpmnElement="Task_select">
        <dc:Bounds x="1630" y="555" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1810" y="572" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1786" y="615" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_contradiction_di" bpmnElement="Task_contradiction">
        <dc:Bounds x="430" y="745" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_matrix_di" bpmnElement="Task_matrix">
        <dc:Bounds x="610" y="745" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_instantiate_di" bpmnElement="Task_instantiate">
        <dc:Bounds x="790" y="745" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_trizcount_di" bpmnElement="Gateway_trizcount" isMarkerVisible="true">
        <dc:Bounds x="970" y="755" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="963" y="728" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
