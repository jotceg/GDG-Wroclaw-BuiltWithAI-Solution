      "minimum": "12px"
    }
  },
  "spacing": { "grid": 8, "scale": [4,8,12,16,20,24,32,40,48,56,72,96], "targets": { "minimum": 24, "primaryAction": 44 } },
  "radii": { "chip": 999, "control": 11, "card": 16, "panel": 18, "badge": 8, "toggle": "50%" },
  "motion": {
    "micro": { "duration": "150-220ms", "easing": "ease-out" },
    "stage-reveal": { "duration": "600ms", "easing": "cubic-bezier(.16,.8,.3,1)", "stagger": "50ms" },
    "reasoning-pulse": { "duration": "1.8s", "easing": "ease-in-out", "loop": true },
    "glow-migration": { "duration": "400ms", "easing": "ease" },
    "theme-crossfade": { "duration": "180ms", "easing": "ease" },
    "theme-icon-morph": { "duration": "140ms", "easing": "ease" },
    "volt-bob": { "duration": "2.6s (1.2s hover)", "easing": "ease-in-out", "loop": true },
    "volt-eye-track": { "range": "±0.45 SVG units (±2-3px)", "transition": "100ms", "disabled": "touch + reduced-motion" },
    "magnetic-hover": { "range": "±5px", "factor": 0.18, "usage": "landing CTA + form submit only" },
    "reducedMotion": "prefers-reduced-motion: reduce kills all"
  },
  "pipeline": {
    "stages": ["Problem", "Parallel Analysis (TRIZ + 5 Whys)", "Merged Candidates", "Evaluation", "Selected Solution"],
    "joinGate": "Both branches must deliver ≥3 candidates before Merged Candidates unlocks; UI shows 'Waiting for [branch] to complete…' if one finishes first, then auto-advances with the stage-reveal motion token.",
    "methods": {
      "triz": {
        "mode": "automatic",
        "subStages": [
          { "id": 1, "label": "Formulating contradiction", "ui": "pulsing reasoning-core dot on active sub-stage" },
          { "id": 2, "label": "Applying contradiction matrix (39×39, pytriz)", "ui": "toast on completion: 'Contradiction formulated' → sub-stage advances, previous marked ✓" },
          { "id": 3, "label": "Instantiating principles into candidates", "ui": "live counter 'n/5 candidates'; 'TRIZ complete ✓' badge at ≥3" }
        ],
        "workspaceRule": "Process only in workspace — formulated contradiction, matrix output and candidate content render exclusively in the Final Report."
      },
      "fivewhys": {
        "mode": "interactive",
        "flow": "User answers up to 5 iterative why questions; AI generates each next question from the previous answer; ends early if root cause detected.",
        "gates": {
          "onTopic": "Off-topic/abusive answer → inline notice 'Let's stay on the problem', same why re-asked, round not consumed.",
          "stuck": "'I'm stuck — suggest hypotheses' button → 2-3 grounded hypotheses (web search), user confirms or rejects one.",
          "rootCause": "If root cause reached before round 5 → timeline shows 'Root cause found at step X', remaining whys disabled, branch closes as complete."
        },
        "editing": "v1: editing a previous answer updates it in place without regenerating later whys; toast 'Answer updated.'",
        "postComplete": "'Generating ≥3 candidates from root cause…' progress, then '5 candidates generated ✓'."
      }
    }
  }
}
